# RootVector auth backend — copy this file to ".env" and fill in your values.
# .env is git-ignored. NEVER commit real secrets.

# From your GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where things are served (defaults are fine for local dev)
FRONTEND_ORIGIN=http://localhost:4178
BACKEND_ORIGIN=http://localhost:5000
PORT=5000
