server/.pgdata-dev/
**/.pgdata*/
*.sqlite

# --- python ---
__pycache__/
**/__pycache__/
*.pyc

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- logs ---
*.log
