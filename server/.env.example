# RootVector backend — copy to .env and fill in. Never commit .env.
PORT=4000

# Postgres from docker-compose (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/rootvector?schema=public

# Long random string. Generate: openssl rand -hex 32
JWT_SECRET=

# Where the static RootVector frontend is served, and this backend's own URL.
FRONTEND_URL=http://localhost:4178
BACKEND_PUBLIC_URL=http://localhost:4000

# Google — the SAME public client id already used in the frontend.
GOOGLE_CLIENT_ID=800195378496-ppr6iadthegssifqiigs8a00flgd39j0.apps.googleusercontent.com

# GitHub OAuth App. Callback URL must be EXACTLY:
#   http://localhost:4000/api/auth/github/callback
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook secrets — inbound alerts create real incidents.
# GitHub: set the SAME value in the repo webhook "Secret" field.
GITHUB_WEBHOOK_SECRET=
# Sentry Internal Integration Client Secret.
SENTRY_CLIENT_SECRET=
# Shared token for the generic alert receivers (Datadog · Grafana · Kubernetes · OpenTelemetry).
# Send it as header `x-rootvector-token` or `?token=` on the webhook.
ALERT_WEBHOOK_SECRET=
# Optional: outbound incident notifications to a Slack Incoming Webhook URL.
SLACK_WEBHOOK_URL=

# Optional AI investigation (LLM) via Google Gemini. Without a key the grounded engine is used.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
